{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "tech-challenge-web": {
      "development": {
        "local": 3000,
        "fallback": "tech-challenge-web.vercel.app"
      }
    },
    "tech-challenge-transacoes": {
      "development": {
        "local": 3005,
        "fallback": "tech-challenge-transacoes.vercel.app"
      },
      "routing": [
        {
          "group": "transacoes",
          "paths": ["/transacoes", "/transacoes/:path*"]
        }
      ]
    }
  }
}
