{
  "name": "tech-challenge",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter=web --filter=storybook dev",
    "typecheck:projects": "node ./scripts/run-typechecks.js",
    "build": "pnpm --filter=./packages/* --if-present build && pnpm --filter=./apps/* --if-present build ",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "storybook": "pnpm --filter=storybook dev",
    "web": "pnpm --filter=web start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.4.5"
  }
}
